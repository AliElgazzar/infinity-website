# Public site URL used for metadata, sitemap, and canonical URLs
NEXT_PUBLIC_SITE_URL=https://infinityesc.com

# Contact form delivery (optional). Without these, submissions are logged
# in development and return a clear configuration message in production.
CONTACT_TO_EMAIL=info@infinityesc.com
CONTACT_FROM_EMAIL=noreply@infinityesc.com

# Resend API key — https://resend.com
# Leave empty to use the development-safe fallback (no email sent).
RESEND_API_KEY=

# Optional shared secret for simple request verification
CONTACT_FORM_SECRET=
